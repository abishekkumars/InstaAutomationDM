# Project-local tooling (downloaded binaries, never committed)
.tools/

# Dependencies
node_modules/
.pnpm-store/

# Env files (never commit secrets)
.env
.env.local
.env.*.local
.env.production
.env.development
.env.test

# Build output
.next/
dist/
build/
out/
coverage/
*.tsbuildinfo

# Local Postgres/Redis fallback data (if the portable-binary option from
# docs/DEVELOPMENT-SETUP.md is used)
.tools/postgres-data/
*.rdb

# Self-signed dev certificates from `next dev --experimental-https` (mkcert). Per-machine,
# and the key must never be committed. Needed locally because Meta's Business Login requires
# an HTTPS redirect URI (META_REDIRECT_URI).
apps/web/certificates/

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Editor/OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# AI coding tool local/session state (not a project artifact)
.claude/

# Prisma
packages/database/generated/

# Playwright
playwright-report/
test-results/

# Turbo (if ever adopted)
.turbo/
