# Copy this file to .env and fill in real values. Never commit .env.
# Every variable is documented here with its purpose — see docs/SECURITY.md for handling rules.

# --- Database (Phase 4) ---
# PostgreSQL connection string used by Prisma (packages/database) in apps/api and apps/worker.
# Local dev: run `.\scripts\db.ps1 start` first (see docs/ADR/0003-local-postgresql-strategy.md),
# then use postgresql://automationdm:automationdm@localhost:5432/automationdm - that is a
# fixed, documented, localhost-only dev credential, not a secret; still, this file only
# ever holds placeholders, per this project's rule of never committing real values here.
DATABASE_URL=

# Non-pooled connection, used by Prisma for migrations/introspection only (never at runtime).
# Local dev: set this to exactly the same value as DATABASE_URL - the local embedded Postgres
# has no pooler in front of it, so there is nothing to bypass.
# Production (Supabase): DATABASE_URL is the *transaction* pooler (port 6543, with
# ?pgbouncer=true appended) and DIRECT_URL is the session pooler / direct connection (port
# 5432). Copy both verbatim from Supabase's "Connect" dialog - do not hand-assemble them.
DIRECT_URL=

# --- Queue (retired scope - see docs/ADR/0005-simplified-mvp-architecture.md) ---
# Redis/BullMQ is not part of this project's architecture: webhook handling is in-process.
# Kept only so an existing .env carrying this variable is not surprising; leave it unset.
REDIS_URL=

# --- Zernio (Phase 8-10) ---
# Server-side only. Never exposed to apps/web. See docs/ZERNIO-INTEGRATION.md.
ZERNIO_API_KEY=
# HMAC-SHA256 secret used to verify the X-Zernio-Signature header on inbound webhooks.
ZERNIO_WEBHOOK_SECRET=

# --- Auth (Phase 5) ---
# Auth.js (next-auth v5) JWT session-signing secret - see docs/ADR/0004-authentication-provider.md.
# Not an external credential: generate your own locally (Windows PowerShell 5.1 has no static
# RandomNumberGenerator.GetBytes, hence RNGCryptoServiceProvider):
#   $b=New-Object byte[] 32; (New-Object System.Security.Cryptography.RNGCryptoServiceProvider).GetBytes($b); [Convert]::ToBase64String($b)
# Never share this value or commit it; rotating it invalidates every existing session.
AUTH_SECRET=

# --- Internal service auth (Phase 6) ---
# HS256 signing secret for the short-lived apps/web -> apps/api bearer token (see
# packages/shared/src/internal-service-token.ts and docs/ARCHITECTURE.md's "Session
# verification (Phase 6)" section). Deliberately a separate secret from AUTH_SECRET - not an
# external credential either; generate the same way:
#   $b=New-Object byte[] 32; (New-Object System.Security.Cryptography.RNGCryptoServiceProvider).GetBytes($b); [Convert]::ToBase64String($b)
API_INTERNAL_SECRET=

# --- Google sign-in (Phase 15.5) ---
# OAuth 2.0 Web application client from Google Cloud Console (APIs & Services > Credentials).
# BOTH must be set or the Google provider is not registered at all and the button is hidden -
# a half-configured provider would make Auth.js throw at import time and break password sign-in
# too, so this fails closed on purpose.
#
# Authorised redirect URI to register with Google, exactly:
#   http://localhost:3000/api/auth/callback/google      (local dev)
#   https://<your-web-domain>/api/auth/callback/google  (production)
#
# Unrelated to the `googleapis` package used by scripts/upload-backup-to-drive.mjs - that is a
# service account for Drive uploads, this is end-user sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Administration (Phase 15.1) ---
# Email address of the bootstrap administrator. The account with this address is promoted to
# the global ADMIN role when it registers, and re-promoted on every subsequent sign-in, so
# pointing this at an existing account grants it admin without any manual database edit.
#
# Only ever PROMOTES - it never demotes. Admins granted through the Administration UI are not
# named here, and recomputing roles from this variable alone would silently revoke them on
# their next sign-in (see packages/shared/src/user-role.ts). Revoking admin is an explicit
# action in that UI instead.
#
# Not a credential - it grants nothing on its own, since the holder still has to authenticate
# normally. Leave unset in an environment that should have no bootstrap admin.
ADMIN_EMAIL=

# --- Object storage (retired scope - see docs/ADR/0005-simplified-mvp-architecture.md) ---
# S3-compatible endpoint; Cloudflare R2 in production.
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=

# --- Observability (Phase 21) ---
SENTRY_DSN=

# --- App ---
# Public base URL of apps/web, used for OAuth redirect URIs etc.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Public base URL of apps/api. Read by apps/web (server-side fetch, e.g. the /status page)
# to reach apps/api; does not need to be a "secret" — it's a URL, not a credential.
NEXT_PUBLIC_API_URL=http://localhost:4000
# apps/api's own view of where apps/web is reachable (Phase 8) - used to build the
# redirect_url passed to Zernio's OAuth connect flow, so apps/api never has to trust a
# client-supplied redirect target. Same value as NEXT_PUBLIC_APP_URL above; kept as a
# separate var because each app reads its own env, not the other's.
APP_URL=http://localhost:3000
NODE_ENV=development
# Port apps/api listens on (see apps/api/src/config/env.validation.ts; defaults to 4000
# if unset).
PORT=4000
