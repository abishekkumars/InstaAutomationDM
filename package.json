{
  "name": "instagram-automation-saas",
  "private": true,
  "version": "0.0.0",
  "description": "Multi-tenant SaaS for Instagram DM automation via the Zernio API.",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "setup": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/setup.ps1",
    "dev": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/dev.ps1",
    "test": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/test.ps1",
    "lint": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/lint.ps1",
    "doctor": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/doctor.ps1",
    "eslint": "eslint .",
    "typecheck": "pnpm --recursive --if-present run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.18.0"
  }
}
