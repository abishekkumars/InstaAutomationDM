// Prisma schema for AutomationDM.
//
// Conventions (documented in full in docs/DATABASE.md "Conventions"):
// - Primary keys: `cuid()` — opaque, non-sequential, no extra dependency (Prisma-native).
// - Timestamps: `createdAt`/`updatedAt` on every table, `updatedAt` via `@updatedAt`.
// - Table/column names: snake_case in Postgres (`@@map`/`@map`), camelCase/PascalCase in
//   Prisma/TypeScript.
// - Every `@@index` exists for a specific, named query pattern — see docs/DATABASE.md.
//
// User, Organization, OrganizationMember (Phase 4/6), InstagramAccount (Phase 7). Automation
// tables land with Phase 10 — see docs/ADR/0005-simplified-mvp-architecture.md for why this
// list is much shorter than the master prompt's original scope (no contacts/conversations/
// analytics/billing tables are planned).

generator client {
  provider = "prisma-client-js"
  // "native" keeps local development working on this Windows machine. The rhel target is
  // the query engine Vercel's Node runtime (Amazon Linux, OpenSSL 3) actually loads - it is
  // downloaded at `prisma generate` time, so it must be declared here rather than discovered
  // at runtime, where a serverless function has no way to fetch it. Without it, every
  // Prisma call on Vercel fails with "Query engine library for current platform not found".
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  // Runtime connection. In production this is Supabase's *transaction* pooler (port 6543,
  // with ?pgbouncer=true): serverless functions scale to many short-lived instances, and a
  // direct connection per instance exhausts Postgres' connection limit almost immediately.
  url = env("DATABASE_URL")

  // Migrations and introspection only. The transaction pooler cannot run them (it multiplexes
  // statements across connections, so it has no stable session for advisory locks or DDL),
  // so Prisma needs a non-pooled path: Supabase's session pooler / direct connection on 5432.
  // Locally both point at the same embedded Postgres - see docs/ADR/0003.
  directUrl = env("DIRECT_URL")
}

/// A user's role across the whole application, as opposed to `OrganizationRole`, which says
/// what they may do *inside one organization*. The two are deliberately separate and neither
/// implies the other: an organization OWNER is not an application ADMIN, and an ADMIN holds no
/// membership anywhere by virtue of being one.
///
/// ADMIN reaches the Administration surface (Phase 15.2) - listing users, assigning them to
/// organizations, and granting/revoking this role. NORMAL_USER is everyone else, and is the
/// default for every account ever created. See docs/SECURITY.md's "Global user roles" section.
enum UserRole {
  ADMIN
  NORMAL_USER
}

/// A human account. `authProviderId`/`authProvider` (Auth.js, Phase 5 — see
/// docs/ADR/0004-authentication-provider.md) name which provider owns this identity;
/// `passwordHash` exists only because the `Credentials` provider was chosen over an OAuth
/// provider — see docs/DATABASE.md, "User model" for the full reasoning.
model User {
  id String @id @default(cuid())

  email String @unique

  /// Global application role (Phase 15.1). Defaults to NORMAL_USER, and is only ever written
  /// server-side: at registration, by the ADMIN_EMAIL bootstrap, or by an existing admin's
  /// explicit action. It is never read from an API request body, and never read from the
  /// apps/web -> apps/api bearer token either - `SessionGuard` re-reads it from this column on
  /// every single request, so a revoked admin loses access immediately rather than at the end
  /// of their token's life. See docs/SECURITY.md.
  role UserRole @default(NORMAL_USER)

  /// Display name. Nullable: not every provider hands us one immediately.
  name String?

  /// Opaque subject/id string from whichever auth provider is eventually wired up
  /// (e.g. a Clerk user id, or an Auth.js account id). Nullable + unique: unpopulated until
  /// Phase 5 picks a provider, but already reservable so nothing about this table's shape
  /// needs to change when that decision lands.
  authProviderId String? @unique @map("auth_provider_id")

  /// Which provider `authProviderId` belongs to (e.g. "clerk", "authjs"). Nullable for the
  /// same reason as `authProviderId`; kept separate rather than folded into a single
  /// "provider:id" string so each half stays independently queryable/indexable.
  authProvider String? @map("auth_provider")

  /// Bcrypt hash of the account password (Auth.js `Credentials` provider, Phase 5 — see
  /// docs/ADR/0004-authentication-provider.md). Nullable: a user created by a future OAuth
  /// provider would have no password at all. Never the plaintext password; never selected
  /// into any API/session response.
  passwordHash String? @map("password_hash")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  memberships OrganizationMember[]

  @@map("users")
}

/// A tenant/workspace. Deliberately minimal — future billing (Phase 20) hangs a
/// `Subscription` table off `Organization.id` rather than growing fields on this table.
model Organization {
  id String @id @default(cuid())

  name String

  /// URL-safe unique handle (e.g. for future `/org/:slug` routing). Uniqueness/format
  /// validation beyond "is it unique" happens at the application layer (Phase 6) — the
  /// schema only guarantees the constraint that matters at the data layer.
  slug String @unique

  /// Zernio's own tenant-boundary id ("profile" in Zernio's terms - see
  /// docs/ZERNIO-INTEGRATION.md's "Account connection" section). Nullable: created lazily on
  /// this organization's first Instagram-connect attempt (Phase 8), not at organization
  /// creation time. Globally unique: Zernio profiles are 1:1 with our organizations, one
  /// profile is never shared across two orgs.
  zernioProfileId String? @unique @map("zernio_profile_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  memberships OrganizationMember[]
  instagramAccounts InstagramAccount[]
  automations Automation[]
  metaConnections MetaConnection[]

  @@map("organizations")
}

/// OWNER: full control, including billing/deletion (once those exist). ADMIN: manage
/// automations/members short of billing/deletion. MEMBER: use the product, no member
/// management. Full RBAC/permissions are a later concern (Phase 6+) — this is just the
/// database-level vocabulary for "what kind of member is this."
enum OrganizationRole {
  OWNER
  ADMIN
  MEMBER
}

/// Join table: which users belong to which organizations, and in what role. A single
/// surrogate `id` (rather than a composite `@@id([organizationId, userId])`) so other
/// tables can reference "this specific membership" by one column later (e.g. an audit log
/// entry recording which membership performed an action) without carrying a compound key
/// around — see docs/DATABASE.md, "OrganizationMember" for the full reasoning. The
/// uniqueness guarantee itself lives in the `@@unique` below, not the primary key.
model OrganizationMember {
  id String @id @default(cuid())

  organizationId String @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  role OrganizationRole @default(MEMBER)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// The same user cannot be added to the same organization twice.
  @@unique([organizationId, userId])
  /// "List members of an organization" — every org dashboard load.
  @@index([organizationId])
  /// "List organizations a user belongs to" — every session/membership check.
  @@index([userId])
  @@map("organization_members")
}

/// CONNECTED: usable normally. DISCONNECTED: the user/Zernio revoked access (still keep the
/// row — its history, and any automations pointing at it, aren't deleted just because the
/// connection lapsed). ERROR: Zernio reported a problem (e.g. token expired unexpectedly)
/// that needs the user's attention to fix by reconnecting.
enum InstagramAccountStatus {
  CONNECTED
  DISCONNECTED
  ERROR
}

/// An Instagram Business/Creator account connected via Zernio (Phase 8 does the real OAuth
/// connect flow; this phase only adds the table). See docs/ZERNIO-INTEGRATION.md for why
/// only Business/Creator accounts are connectable at all.
model InstagramAccount {
  id String @id @default(cuid())

  organizationId String @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// Zernio's own account/profile identifier. Globally unique (not just unique per org) -
  /// this is deliberate, not an oversight: an inbound Zernio webhook identifies the account
  /// only by this id, and docs/WEBHOOKS.md's org-resolution step ("look up the account,
  /// resolve its organization_id") must be unambiguous. If the same id could exist under two
  /// different organizations, that lookup would have no correct answer.
  zernioAccountId String @unique @map("zernio_account_id")

  /// Instagram handle, if Zernio provides one at connect time. Nullable for the same reason
  /// as User.name - not guaranteed to be available immediately from every connect path.
  username String? @map("username")

  status InstagramAccountStatus @default(CONNECTED)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  automations Automation[]

  metaConnection MetaConnection?

  /// "List an organization's connected accounts" - every account-picker UI load.
  @@index([organizationId])
  @@map("instagram_accounts")
}

/// Whether the stored Meta token can still be used.
///
/// RECONNECT_REQUIRED is set when Meta rejects the token itself (OAuthException code 190/102)
/// or a refresh fails - not when a call merely errors. The distinction matters: a transient
/// Meta outage must fall back to Zernio and recover on its own, while a dead token needs the
/// user to act, and only the second should nag them.
enum MetaConnectionStatus {
  CONNECTED
  RECONNECT_REQUIRED
}

/// A direct Meta Graph API connection for one Instagram account (Phase 17).
///
/// This exists alongside - not instead of - the Zernio connection on InstagramAccount. Zernio
/// remains the system of record for automations; Meta is a read-only source for listing
/// posts/reels, because Zernio's sync lags a newly published reel by hours and only retains
/// ~12 months. See docs/ADR/0009-direct-meta-graph-api-for-post-listing.md.
///
/// One row per Instagram account (`@unique` on the FK, giving a true 1:1). An account either
/// has a Meta connection or falls back to Zernio for listing; there is no meaning to a second
/// connection for the same account.
model MetaConnection {
  id String @id @default(cuid())

  /// Denormalised from InstagramAccount so every query can be organization-scoped without a
  /// join, matching the tenant-scoping rule in CLAUDE.md ("every query touching tenant-owned
  /// data enforces organization_id").
  organizationId String @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  instagramAccountId String @unique @map("instagram_account_id")
  instagramAccount   InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)

  /// Instagram's own user id for this account, from Meta's `GET /me`. Not the same value as
  /// InstagramAccount.zernioAccountId, which is Zernio's identifier for the same account.
  igUserId String @map("ig_user_id")

  /// The long-lived Instagram user access token, **encrypted at rest** with AES-256-GCM
  /// (packages/shared/src/token-crypto.ts). Never stored, logged, or returned in plaintext -
  /// see docs/SECURITY.md. The column holds the `v1.<iv>.<tag>.<ciphertext>` envelope, so no
  /// separate IV column has to be kept in sync with it.
  accessTokenEncrypted String @map("access_token_encrypted")

  /// When the stored token expires (Meta long-lived tokens last 60 days). Drives the lazy
  /// refresh: a token inside its last 7 days is refreshed on next use.
  expiresAt DateTime @map("expires_at")

  /// Scopes actually granted, as Meta reported them. Stored so a future feature needing a
  /// scope this connection lacks can detect that and prompt a reconnect, rather than failing
  /// with an opaque permissions error at call time.
  scopes String[]

  status MetaConnectionStatus @default(CONNECTED)

  /// Last time a Meta call using this connection succeeded. Nullable until the first one - a
  /// connection that has never been used is a different thing from one that used to work.
  lastUsedAt DateTime? @map("last_used_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// "List an organization's Meta connections" - the settings/status view.
  @@index([organizationId])
  @@map("meta_connections")
}

/// How a keyword is compared against a comment's text (Zernio's own `matchMode` values,
/// see docs/ZERNIO-INTEGRATION.md's "Comment-to-DM automation API" section). CONTAINS matches
/// anywhere in the text, WORD matches only as a standalone word, EXACT requires the whole
/// comment to equal the keyword.
enum AutomationMatchMode {
  CONTAINS
  WORD
  EXACT
}

/// Which commenters an automation is allowed to answer (Phase 16.2, requirement 11). Maps onto
/// Zernio's `audience.followerStatus` (`any` | `follower` | `non_follower`).
///
/// Instagram only reveals the follow relationship for people who have messaged the account
/// before, so this is not a guarantee Zernio can always evaluate - see
/// docs/ZERNIO-INTEGRATION.md for how `audience.whenUnknown` decides what happens for everyone
/// else. Only the follower-status axis is stored: Zernio's `minFollowerCount` and the
/// `followGate` copy are real but out of this project's scope.
enum AutomationAudience {
  ANY
  FOLLOWER
  NON_FOLLOWER
}

/// A comment-to-DM automation (Phase 10). One org + one connected Instagram account + one
/// specific Zernio post/reel + keyword(s) + optional public reply + DM message - see
/// docs/AUTOMATION-ENGINE.md's "Model" section for why this is a fixed shape, not a generic
/// trigger/condition/action graph. Zernio's own comment-automations API executes the actual
/// keyword-matching, public reply, and DM send server-side (verified live during this phase,
/// resolving docs/AUTOMATION-ENGINE.md's "Open question") - this row mirrors that
/// server-side config locally so our own tenant-isolation checks never have to trust an
/// unscoped Zernio lookup, and so Phase 11's inbound webhook can resolve back to an
/// organization the same way InstagramAccount.zernioAccountId already does.
model Automation {
  id String @id @default(cuid())

  organizationId String @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  instagramAccountId String @map("instagram_account_id")
  instagramAccount   InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)

  /// Zernio's own comment-automation id. Globally unique for the same reason as
  /// InstagramAccount.zernioAccountId - an inbound webhook identifies the automation only by
  /// this id, and that lookup must be unambiguous.
  zernioAutomationId String @unique @map("zernio_automation_id")

  /// Instagram's own media id - the post/reel this automation is scoped to (Phase 17).
  ///
  /// This is the identifier an incoming comment actually reports, the one Zernio's
  /// `POST /v1/comment-automations` takes as `platformPostId`, and the only one both the Meta
  /// and Zernio listing paths can produce. Verified by hand on 2026-08-19: Zernio accepts it
  /// **without** a companion `postId` and the automation fires correctly, which is what makes
  /// automating a post Zernio has not synced yet possible at all.
  ///
  /// It replaced `zernio_post_id` as the pivot because Zernio only mints its own `_id` once its
  /// poll-driven sync catches up - hours after publishing - which made a freshly published reel
  /// unautomatable. See docs/ADR/0009-direct-meta-graph-api-for-post-listing.md.
  platformPostId String @map("platform_post_id")

  name String

  /// Trigger keywords. **An empty array means "any comment triggers this automation"** - that is
  /// Zernio's own documented semantics for an empty `keywords` list, not a local convention
  /// (verified against the live OpenAPI spec, Phase 16.2 - see docs/ZERNIO-INTEGRATION.md). The
  /// create wizard's "Any comments" tab is exactly this, and `matchMode` is meaningless when the
  /// list is empty since there is nothing to match against.
  keywords String[]
  matchMode AutomationMatchMode @default(CONTAINS) @map("match_mode")

  /// Who the automation is allowed to answer (Phase 16.2, requirement 11). Mirrors Zernio's
  /// `audience.followerStatus`. ANY is the default and the behaviour every automation had before
  /// this field existed, so existing rows are correct without a data migration.
  audience AutomationAudience @default(ANY)

  /// Optional public reply posted on the triggering comment. Nullable: Zernio's own API
  /// treats this as optional, not required (a DM-only automation with no public reply is a
  /// normal, supported configuration).
  commentReply String? @map("comment_reply")

  /// Up to 5 alternate public replies (Phase 16.2, requirement 13). Zernio picks ONE at random
  /// per triggering comment from `[commentReply, ...commentReplyVariations]` - it does not post
  /// all of them. Rotation exists so repeat commenters on the same post do not all receive a
  /// visibly identical reply. Empty when the automation has a single fixed reply.
  commentReplyVariations String[] @map("comment_reply_variations")
  dmMessage String @map("dm_message")

  /// Up to 3 inline DM buttons, `[{ title, url }]`. Zernio's own `buttons` field supports
  /// `type: url | postback | phone` (docs/ZERNIO-INTEGRATION.md's "Comment-to-DM automation
  /// API" section) - this project only ever sends `type: "url"` (postback needs a webhook
  /// handler this project doesn't have; phone is Facebook-only, irrelevant to an
  /// Instagram-only tool), so the type itself isn't stored, only title+url pairs. Null/empty
  /// when the automation has no buttons - a plain-text DM is a fully supported, normal
  /// configuration. A JSON column, not a separate table: at most 3 small, fixed-shape items
  /// that are never queried independently of their automation.
  buttons Json?

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// Mirrors Zernio's own "only one active per-post automation" rule (docs/ZERNIO-INTEGRATION.md) -
  /// enforced at our own data layer too, not just trusted from Zernio's 409.
  ///
  /// Keyed on `platformPostId` since Phase 17 - Instagram's media id, which is what an incoming
  /// comment reports and therefore what "one automation per post" actually means.
  @@unique([instagramAccountId, platformPostId])
  /// "List an organization's automations" - a future dashboard/history view (Phase 12).
  @@index([organizationId])
  @@map("automations")
}
